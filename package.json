{
  "name": "auraspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs tests/run.mjs",
    "typecheck": "tsc --noEmit",
