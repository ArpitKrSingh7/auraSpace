    "react-dom": "^18.3.0",
    "three": "^0.160.0",
    "zod": "^3.22.0",
    "zustand": "^4.5.0",
    "@auraspace/scene-domain": "workspace:*",
    "@auraspace/scene-assets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "autoprefixer": "^10.4.0",
